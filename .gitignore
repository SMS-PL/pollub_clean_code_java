# Local environment and private application configuration
.env
.env.*
!.env.example
!.env.sample
/src/main/resources/application-local.properties
/src/main/resources/application-local.yml
/src/main/resources/application-local.yaml

# Operating system and temporary editor files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.bak

# Keep Maven Wrapper files in Git, including the JAR if added later.
!.mvn/wrapper/maven-wrapper.jar
