# Java and Maven build output
/target/
*.class

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# Eclipse / Spring Tool Suite
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache/

# VS Code workspace settings
.vscode/

# Local H2 database files (including lock and trace files)
/data/
*.mv.db
*.lock.db
*.trace.db
*.h2.db

# Logs and JVM crash / heap dumps
*.log
/logs/
hs_err_pid*
replay_pid*
